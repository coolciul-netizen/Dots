{
    "layer": "top",
    "position": "top",
    "height": 28,
    "margin-top": 10,
    "margin-left": 15,
    "margin-right": 15,
    "fixed-center": true,
    
    "modules-left": ["custom/launcher", "sway/workspaces"],
    "modules-center": ["sway/window"], 
    "modules-right": ["group/system", "tray"],

    "group/system": {
    	"orientation": "horizontal",
    	"modules": ["clock", "cpu", "memory"]
    },
    "tray": {
    	"icon-size": 16,
    	"spacing": 8
    },
    "custom/launcher": {
    	"format": "",
    	"on-click": "rofi -show drun -theme /home/michal/.config/rofi/monochromes/monochrome-gentooikon.rasi -show-icons",
    	"tooltip": false
    },

    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{name}"
    },

    "sway/window": {
    "format": "{title}",
    "min-length": 130,
    "max-length": 130,
    "separate-outputs": true,
    "rewrite": {
        "^$": "Desktop"
    	}
    },
    "clock": {
        "format": "{:%H:%M}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
    },

    "cpu": {
        "format": "⚡ {usage}%",
        "tooltip": false
    },

    "memory": {
        "format": "🧠 {percentage}%"
    },

    "tray": {
    	"icon-size": 18,
    	"spacing": 8
    }
}

