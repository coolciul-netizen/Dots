* {
    background-color:   transparent;
    text-color:         #ffffff;
    font:               "JetBrains Mono 13";
}

window {
    background-color:   #00000095;
    border:             1px;
    border-color:       #ffffff33;
    border-radius:      0px;
    width:              800px;
    padding:            10px;
}

mainbox {
    background-color:   transparent;
    spacing:            0px;
    padding:            0px;
}

inputbar {
    background-color:   transparent;
    border:             0px 0px 1px 0px;
    border-color:       #ffffff33;
    padding:            8px 10px;
    spacing:            0px;
    children:           [ prompt, entry ];
}

prompt {
    background-color:   transparent;
    enabled:            false;
    padding:            0px 8px 0px 0px;
}

entry {
    background-color:   transparent;
    text-color:         #ffffff;
    placeholder:        "Search...";
    placeholder-color:  #ffffff4d;
}

listview {
    background-color:   transparent;
    padding:            6px 0px 0px 0px;
    spacing:            2px;
    lines:              5;
}

element {
    background-color:   transparent;
    padding:            13px 15px;
    spacing:            7px;
    border-radius:      0px;
}

element selected {
    background-color:   #ffffff26;
}

element-icon {
    size:               28px;
    background-color:   transparent;
}

element-text {
    background-color:   transparent;
    text-color:         #ffffff;
    vertical-align:     0.5;
}
