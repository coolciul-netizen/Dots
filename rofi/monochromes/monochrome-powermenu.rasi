/* Monochrome Pitch-Black & White Rofi Theme */

* {
    bg:             #000000;
    bg-alt:         #121212;
    fg:             #FFFFFF;
    fg-alt:         #888888;
    border-col:     #FFFFFF;

    background-color:   transparent;
    text-color:         @fg;
    font:               "JetBrains Mono Medium 13";
}

window {
    background-color:   @bg;
    border:             1px;
    border-color:       @border-col;
    border-radius:      0px;
    width:              600px;
    padding:            10px;
}


//prompt {
//    text-color:         @fg;
//    str:                "drun >";
//}

entry {
    text-color:         @fg;
    placeholder:        "Search...";
    placeholder-color:  @fg-alt;
}

listview {
    lines:              1;
    columns:            3;
    fixed-height:       true;
    spacing:            4px;
    cycle:              true;
}

element {
    padding:		40px 10px;
    border-radius:      2px;
    background-color:   @bg;
    text-color:         @fg-alt;
}

element selected {
    background-color:   @fg;
    text-color:         @bg;
}

element-text {
    text-color:         inherit;
    vertical-align:     0.5;
}

element-icon {
    size:               20px;
    padding:            0 8px 0 0;
}
