/* Monochrome Pitch-Black & White Rofi Theme */

* {
    bg:             #000000;
    bg-alt:         #121212;
    fg:             #FFFFFF;
    fg-alt:         #888888;
    border-col:     #FFFFFF;

    background-color:   transparent;
    text-color:         @fg;
    font:               "JetBrains Mono Medium 12";
}

window {
    background-color:   @bg;
    border:             1px;
    border-color:       @border-col;
    border-radius:      0px;
    width:              1200px;
    padding:            10px;
}

mainbox {
    spacing:            20px;
    children:           [ inputbar, listview ];
}

inputbar {
    background-color:   @bg-alt;
    border:             1px;
    border-color:       #262626;
    padding:            10px 14px;
    spacing:            10px;
    children:           [ entry ];
}

//prompt {
//    text-color:         @fg;
//    str:                "drun >";
//}

entry {
    text-color:         @fg;
    placeholder:        "Search...";
    placeholder-color:  @fg-alt;
}

listview {
    lines:              6;
    columns:            4;
    fixed-height:       true;
    spacing:            4px;
    cycle:              true;
}

element {
    padding:		20px 5px;
    border-radius:      6px;
    background-color:   @bg;
    text-color:         @fg-alt;
}

element selected {
    background-color:   @fg;
    text-color:         @bg;
}

element-text {
    text-color:         inherit;
    vertical-align:     0.5;
}

element-icon {
    size:               48px;
    padding:            0 8px 0 0;
}
